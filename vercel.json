{
  "installCommand": "npm --prefix astro install",
  "buildCommand": "npm --prefix astro run build",
  "outputDirectory": "astro/dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/reynosa.html",
      "destination": "/reynosa/",
      "permanent": true
    }
  ]
}
