---
const campuses = [
  {
    name: 'Campus Reynosa',
    href: '/reynosa/',
    image: '/images/home/campus-reynosa.webp',
  },
  {
    name: 'Campus Tampico',
    href: 'https://tampico.uvb.edu.mx/',
    image: '/images/home/campus-tampico.webp',
  },
];
---

<section class="campuses" aria-labelledby="campuses-title">
  <div class="section-inner">
    <h2 id="campuses-title">Selecciona tu Campus</h2>
    <div class="campus-grid">
      {campuses.map((campus) => (
        <a class="campus-card" href={campus.href} aria-label={campus.name}>
          <img src={campus.image} alt="" loading="lazy" />
          <span>{campus.name.toUpperCase()}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .campuses {
    background: #fff;
    padding: 56px 0 64px;
  }

  .section-inner {
    width: min(1130px, calc(100% - 48px));
    margin: 0 auto;
  }

  h2 {
    margin: 0 0 34px;
    color: #076628;
    font-family: Montserrat, sans-serif;
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 400;
    line-height: 1.15;
    text-align: center;
  }

  .campus-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  .campus-card {
    position: relative;
    display: block;
    min-height: 260px;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
  }

  .campus-card::after {
    position: absolute;
    inset: 0;
    content: '';
    background: rgba(0, 0, 0, 0.42);
  }

  .campus-card img {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .campus-card span {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    padding: 24px;
    font-family: Montserrat, sans-serif;
    font-size: 25px;
    line-height: 1.2;
    text-align: center;
  }

  .campus-card:hover img {
    transform: scale(1.04);
  }

  @media (max-width: 768px) {
    .campuses {
      padding: 50px 0;
    }

    .section-inner {
      width: calc(100% - 32px);
    }

    .campus-grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }
  }
</style>
