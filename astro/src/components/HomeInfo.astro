---
interface Props {
  welcomeTitle?: string;
  paragraph1?: string;
  paragraph2?: string;
  rulesTitle?: string;
  rulesHigherText?: string;
  rulesHigherHref?: string;
  rulesHighschoolText?: string;
  rulesHighschoolHref?: string;
}

const {
  welcomeTitle = 'Te damos la bienvenida a la UVB',
  paragraph1 = 'En la <strong>Universidad Valle del Bravo</strong> formamos profesionistas preparados para enfrentar los retos del mundo actual con conocimiento, ética y liderazgo. Con más de 45 años de trayectoria en la educación privada, nos enorgullece contar con dos campus: Tampico y Reynosa, donde ofrecemos programas educativos de alta calidad.',
  paragraph2 = 'Nuestra oferta incluye <strong>preparatoria</strong>, una amplia variedad de <strong>licenciaturas</strong> y programas de <strong>educación continua</strong>, todos diseñados para impulsar tu desarrollo personal y profesional. En la UVB, combinamos innovación, tecnología y formación integral para que alcances tu máximo potencial y transformes tu entorno.',
  rulesTitle = 'Normatividad',
  rulesHigherText = 'Reglamento General de Estudiantes de Tipo Superior',
  rulesHigherHref = '/reglamento-ts/',
  rulesHighschoolText = 'Reglamento Escolar Bachillerato',
  rulesHighschoolHref = '/reglamento-bachillerato/',
} = Astro.props;
---

<section class="info" aria-labelledby="welcome-title">
  <div class="section-inner info__grid">
    <article>
      <h2 id="welcome-title">{welcomeTitle}</h2>
      <p><Fragment set:html={paragraph1} /></p>
      <p><Fragment set:html={paragraph2} /></p>
    </article>
    <aside aria-labelledby="rules-title">
      <h2 id="rules-title">{rulesTitle}</h2>
      <a href={rulesHigherHref}>{rulesHigherText}</a>
      <a href={rulesHighschoolHref}>{rulesHighschoolText}</a>
    </aside>
  </div>
</section>

<style>
  .info {
    background: #f2f2f2;
    padding: 72px 0;
  }

  .section-inner {
    width: min(1130px, calc(100% - 48px));
    margin: 0 auto;
  }

  .info__grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
    gap: 48px;
    align-items: start;
  }

  h2 {
    margin: 0 0 22px;
    color: #076628;
    font-family: Montserrat, sans-serif;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.2;
  }

  p {
    margin: 0 0 18px;
    color: #444;
    font-family: Montserrat, sans-serif;
    font-size: 16px;
    line-height: 1.75;
  }

  aside a {
    display: block;
    margin-bottom: 14px;
    padding: 17px 18px;
    background: #076628;
    color: #fff;
    font-family: Montserrat, sans-serif;
    font-size: 15px;
    line-height: 1.35;
    text-align: center;
    text-decoration: none;
  }

  aside a:hover {
    background: #0a7a32;
  }

  @media (max-width: 768px) {
    .info {
      padding: 52px 0;
    }

    .section-inner {
      width: calc(100% - 32px);
    }

    .info__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
