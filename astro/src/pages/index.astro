---
import CampusSelector from '../components/CampusSelector.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeInfo from '../components/HomeInfo.astro';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>UVB Universidad Valle del Bravo - Somos La Valle</title>
    <meta
      name="description"
      content="Universidad Valle del Bravo. Somos La Valle, con campus Tampico y Reynosa."
    />
    <link rel="canonical" href="https://uvb.edu.mx/" />
    <link rel="icon" href="/uvb.edu.mx/wp-content/uploads/2025/07/favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css?family=Montserrat:400,500,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <HomeHero />
    <CampusSelector />
    <HomeInfo />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #fff;
    font-family: Montserrat, sans-serif;
    color: #222;
  }
</style>
