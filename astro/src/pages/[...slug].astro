---
import {
  getMirrorRoutes,
  getMirrorSourcePath,
  readMirrorHtml,
} from '../lib/mirror-pages';

export function getStaticPaths() {
  return getMirrorRoutes().map((route) => ({
    params: {
      slug: route,
    },
  }));
}

const sourcePath = getMirrorSourcePath(Astro.params.slug);
const html = readMirrorHtml(sourcePath);
---

<Fragment set:html={html} />
