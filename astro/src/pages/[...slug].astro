---
import {
  getMirrorRoutes,
  getMirrorSourcePath,
} from '../lib/mirror-pages';
import MirrorPage from '../components/MirrorPage.astro';

export function getStaticPaths() {
  return getMirrorRoutes().map((route) => ({
    params: {
      slug: route,
    },
  }));
}

const sourcePath = getMirrorSourcePath(Astro.params.slug);
---

<MirrorPage sourcePath={sourcePath} />
